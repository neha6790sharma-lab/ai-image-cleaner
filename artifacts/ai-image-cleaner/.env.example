# Copy this file to .env and fill in real values.
# .env is gitignored - never commit real keys.

# --- Frontend (VITE_ prefixed vars are exposed to the browser) ---

# Your Supabase project URL (Dashboard > Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable (anon) key - safe to expose in the client bundle
VITE_SUPABASE_ANON_KEY=sb_publishable_your_anon_key_here

# --- Server-side only (never import these from src/, used by scripts only) ---

# Secret / service role key - only used by server-side scripts such as
# `pnpm create-admin` and `pnpm sitemap`. Never placed in frontend code.
SUPABASE_SECRET_KEY=sb_secret_your_service_role_key_here

# Optional: your deployed site origin, used when generating sitemap.xml
# SITE_URL=https://your-domain.example